{
  "manifest_version": 3,
  "name": "DNC & TCPA Compliance Lookup",
  "version": "1.9.13",
  "description": "Parallel automated compliance lookup (DNC, Litigator, Blacklist) and identity extractionand Unmask DOB automation.",
  "permissions": [
    "offscreen",
    "declarativeNetRequest",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "cookies"
  ],
  "host_permissions": [
    "https://auto-lookup-portal.vercel.app/*",
    "https://infolookupp.com/*",
    "https://infolookup.site/*",
    "https://www.uspeoplesearch.net/*",
    "https://uspeoplesearch.net/*",
    "https://*.amica.com/*",
    "https://amica.com/*",
    "https://*.mercuryinsurance.com/*",
    "https://mercuryinsurance.com/*",
    "https://*.unmask.com/*",
    "https://unmask.com/*",
    "https://thatsthem.com/*",
    "https://*.thatsthem.com/*",
    "https://www.google.com/*",
    "https://nominatim.openstreetmap.org/*",
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://infolookupp.com/*",
        "https://infolookup.site/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.uspeoplesearch.net/*",
        "https://uspeoplesearch.net/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.amica.com/*",
        "https://amica.com/*"
      ],
      "js": [
        "amica_automation.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.mercuryinsurance.com/*",
        "https://mercuryinsurance.com/*"
      ],
      "js": [
        "mercury_automation.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.unmask.com/*",
        "https://unmask.com/*"
      ],
      "js": [
        "unmask_automation.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://thatsthem.com/*",
        "https://*.thatsthem.com/*"
      ],
      "js": [
        "thatsthem_automation.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/*"
      ],
      "js": [
        "google_automation.js",
        "google_email_automation.js",
        "google_gender_automation.js",
        "google_address_automation.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Toggle Sticky DNC & Identity Lookup",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "umairzakira6@gmail.com",
      "strict_min_version": "115.11"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "Poppins/*",
        "logo.png",
        "bg.jpg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
